[Tests]
  design = 'NDSmallDeformationIsotropicElasticity.md'
  issues = '#permeability_normal_strain'

  [isotropic_axis]
    type = 'Exodiff'
    input = 'isotropic_axis.i'
    exodiff = 'isotropic_axis_out.e'
    requirement = 'The system shall compute the Heider (2021) normal-strain '
                  'permeability with isotropic fallback and an axis-aligned '
                  'damage gradient, producing an isotropic effective permeability '
                  'tensor with magnitude K = k0*I + d^b * (h_c*|1+eps_nn|)^2/12 * I.'
  []

  [anisotropic_axis]
    type = 'Exodiff'
    input = 'anisotropic_axis.i'
    exodiff = 'anisotropic_axis_out.e'
    requirement = 'The system shall compute the Heider (2021) normal-strain '
                  'permeability with anisotropic tangential projector and '
                  'axis-aligned damage gradient, producing zero enhancement in '
                  'the crack-normal direction and full cubic-law enhancement in '
                  'the two tangential directions.'
  []

  [anisotropic_rotated]
    type = 'Exodiff'
    input = 'anisotropic_rotated.i'
    exodiff = 'anisotropic_rotated_out.e'
    requirement = 'The system shall correctly apply the tangential projector '
                  'I - n_d (x) n_d in the global frame for a 45-degree damage '
                  'gradient, producing K_xx = K_yy = k0 + alpha/2 and '
                  'K_xy = -alpha/2 (sign-sensitive verification).'
  []

  [anisotropic_rotated_analytical_sign]
    # Analytical sign-test: the gold CSV contains hand-computed values (see
    # EXPECTED_VALUES.md for the derivation). A projector built as I + n_d*n_d
    # (wrong sign), or an off-by-one in the outer-product loop, would flip the
    # sign of K_xy and fail this check.
    type = 'CSVDiff'
    input = 'anisotropic_rotated.i'
    csvdiff = 'anisotropic_rotated_csv.csv'
    rel_err = 1e-10
    prereq = 'anisotropic_rotated'
    requirement = 'The 45-degree rotation case shall match hand-computed '
                  'analytical values for K_xx, K_yy, K_zz and K_xy to '
                  'machine precision, catching any sign error in the '
                  'tangential projector or outer-product indexing.'
  []

  [principal_strain_fallback]
    type = 'Exodiff'
    input = 'principal_strain_fallback.i'
    exodiff = 'principal_strain_fallback_out.e'
    requirement = 'The system shall use the most-tensile principal-strain '
                  'eigenvector as the crack normal n_d when '
                  'crack_normal_source = principal_strain, even where the '
                  'damage gradient is identically zero.'
  []

  [legacy_darcy_poiseuille]
    type = 'Exodiff'
    input = 'legacy_darcy_poiseuille.i'
    exodiff = 'legacy_darcy_poiseuille_out.e'
    requirement = 'The system shall preserve the pre-existing '
                  'darcy_poiseuille_permeability_model branch behavior, '
                  'producing the same effective_perm as before the '
                  'normal-strain refactor when the legacy flag is enabled.'
  []

  [heaviside_boundary]
    type = 'Exodiff'
    input = 'heaviside_boundary.i'
    exodiff = 'heaviside_boundary_out.e'
    requirement = 'At d = d_threshold exactly, the Heaviside gate '
                  'chi_d = H(d - d_threshold) shall evaluate to 1 '
                  '(plan convention H(0) = 1, "d >= threshold"), so the '
                  'fracture permeability activates at the boundary and '
                  'K_yy = k0 + d^b * k_w (NOT K_yy = k0). This test '
                  'verifies the Phase-1 acceptance criterion at d = 0.5.'
  []

  [residual_aperture]
    type = 'Exodiff'
    input = 'residual_aperture.i'
    exodiff = 'residual_aperture_out.e'
    requirement = 'When the open-crack aperture w_c falls below the residual '
                  'aperture w_r (Heider 2021 eq. 46 closed-crack branch), the '
                  'system shall use w_h = f_c*w_r*chi_d so the fracture '
                  'permeability decays to (f_c*w_r)^2/12 * (I - n_d (x) n_d) '
                  'rather than collapsing to zero. With residual_aperture = 0 '
                  '(default) the closed branch is inactive and legacy '
                  'open-only behavior is preserved.'
  []

  [regularized_normal_core]
    type = 'Exodiff'
    input = 'regularized_normal_core.i'
    exodiff = 'regularized_normal_core_out.e'
    # The gold could not be generated in the authoring environment (the app
    # executable will not link on macOS Tahoe 26.5 - see the toolchain note).
    # Remove this skip and add gold/regularized_normal_core_out.e once the app
    # builds: `farms-opt -i regularized_normal_core.i && cp
    # regularized_normal_core_out.e gold/` (verify against EXPECTED_VALUES Test 8).
    skip = 'gold pending: regularized_normal_core_out.e not yet generated (toolchain link failure)'
    requirement = 'When regularize_crack_normal = true, the system shall '
                  'compute the crack normal as n_d = grad(d)/(|grad(d)| + eps), '
                  'so that at the fully-damaged crack core where grad(d) = 0 '
                  'the normal collapses to zero and the tangential projector '
                  '(I - n_d (x) n_d) reduces to the identity, producing an '
                  'ISOTROPIC fracture permeability K = k0*I + d^b*(h_c^2/12)*I '
                  'there instead of the legacy hard-cutoff fallback to the '
                  'matrix permeability k0*I.'
  []

  [regularized_normal_undamaged]
    type = 'Exodiff'
    input = 'regularized_normal_undamaged.i'
    exodiff = 'regularized_normal_undamaged_out.e'
    # Gold pending for the same toolchain reason as regularized_normal_core.
    # Generate once the app builds: `farms-opt -i regularized_normal_undamaged.i
    # && cp regularized_normal_undamaged_out.e gold/` (verify K = k0*I = 5e-19).
    skip = 'gold pending: regularized_normal_undamaged_out.e not yet generated (toolchain link failure)'
    requirement = 'With regularize_crack_normal = true and uniform damage '
                  'd below damage_threshold_for_permeability, the system shall '
                  'fall back to the matrix permeability K = k0*I via the chi_d '
                  'gate (even though the regularized normal sets n_d = 0 and '
                  'have_normal = true), so the regularized normal does NOT '
                  'manufacture fracture permeability in undamaged material. '
                  'This verifies the d=0 side of the d=0/d=1 separation.'
  []

  [regularized_normal_requires_eps]
    type = 'RunException'
    input = 'regularized_normal_requires_eps.i'
    expect_err = 'regularize_crack_normal = true requires crack_normal_regularization to be set explicitly'
    requirement = 'When regularize_crack_normal = true but '
                  'crack_normal_regularization is left at its default, the '
                  'system shall error during construction, because the default '
                  'epsilon is far below the phase-field gradient scale and the '
                  'regularization would otherwise be a silent no-op.'
  []

  [strain_based_normal]
    type = 'Exodiff'
    input = 'strain_based_normal.i'
    exodiff = 'strain_based_normal_out.e'
    requirement = 'With crack_normal_source = principal_strain, the system shall '
                  'compute the crack normal as n_F = e_1, the eigenvector of the '
                  'maximum principal strain of the mechanical strain (Liu 2024 '
                  'CMAME eqs. 29-30), so that when grad(d) is parallel to e_x but '
                  'e_1 = e_y the tangential projector blocks the y-direction '
                  '(K_yy = k0) and enhances the x,z directions '
                  '(K_xx = K_zz = k0 + d^b*k_w) -- the opposite diagonal entry '
                  'from what the damage-gradient normal would block, proving the '
                  'normal is strain-based and not damage-based.'
  []

  [strain_based_compression]
    type = 'Exodiff'
    input = 'strain_based_compression.i'
    exodiff = 'strain_based_compression_out.e'
    requirement = 'With crack_normal_source = principal_strain, a damaged element '
                  '(d >= threshold) under in-plane compression (both in-plane '
                  'principal strains negative, so the plane-strain maximum '
                  'principal strain is the out-of-plane eps_zz = 0 with e_1 = e_z) '
                  'shall NOT receive a spurious fracture permeability: the '
                  'eps_1 > 0 tensile-opening gate routes the closed crack to the '
                  'matrix permeability K = k0*I instead of enhancing the in-plane '
                  'permeability.'
  []

  [bulk_modulus_spectral_undamaged]
    # d=0 -> g=1 -> C = C_intact -> K_eff = K, regardless of strain (tension imposed).
    type = 'CSVDiff'
    input = 'bulk_modulus_spectral.i'
    cli_args = 'AuxKernels/d_aux/function=0
                AuxKernels/disp_x_aux/function=1e-3*x
                AuxKernels/disp_y_aux/function=2e-3*y
                Outputs/csv/file_base=bulk_modulus_spectral_undamaged'
    csvdiff = 'bulk_modulus_spectral_undamaged.csv'
    rel_err = 1e-8
    requirement = 'The system shall extract the bulk modulus K_eff = K = (1/9) I:C:I '
                  'from the degraded SPECTRAL elastic tangent in the undamaged limit '
                  '(g=1), independent of the strain state.'
  []

  [bulk_modulus_spectral_compression]
    # d=0.7, biaxial compression -> tr eps < 0 (H_tr=0), N+=0 -> K_eff = K (crack closure).
    type = 'CSVDiff'
    input = 'bulk_modulus_spectral.i'
    cli_args = 'AuxKernels/d_aux/function=0.7
                AuxKernels/disp_x_aux/function=-1e-3*x
                AuxKernels/disp_y_aux/function=-2e-3*y
                Outputs/csv/file_base=bulk_modulus_spectral_compression'
    csvdiff = 'bulk_modulus_spectral_compression.csv'
    rel_err = 1e-8
    requirement = 'The system shall extract the full bulk modulus K_eff = K from the '
                  'SPECTRAL tensor under pure compression at d=0.7, since the spectral '
                  'split degrades no volumetric stiffness when the crack is closed.'
  []

  [bulk_modulus_spectral_tension]
    # d=0.7, biaxial tension eps=diag(1e-3,2e-3,0) -> H_tr=1, N+=2 (out-of-plane eig=0).
    # K_eff = K + (g-1)(K - 2G/9) = 7.6389229168e9 (depends only on H_tr and N+).
    type = 'CSVDiff'
    input = 'bulk_modulus_spectral.i'
    cli_args = 'AuxKernels/d_aux/function=0.7
                AuxKernels/disp_x_aux/function=1e-3*x
                AuxKernels/disp_y_aux/function=2e-3*y
                Outputs/csv/file_base=bulk_modulus_spectral_tension'
    csvdiff = 'bulk_modulus_spectral_tension.csv'
    rel_err = 1e-8
    requirement = 'The system shall extract the degraded bulk modulus from the SPECTRAL '
                  'tensor under tension at d=0.7, matching the analytic '
                  'K + (g-1)(K - 2G/9) with N+=2; this discriminates the true I (x) I '
                  'contraction from the diagonal-only RankFourTensor(initIdentity).'
  []

  [bulk_modulus_none_compression]
    # decomposition=NONE has no tension/compression split: K_eff = g*K for ANY strain.
    # d=0.7 -> g=0.09000091 -> g*K = 3.7500379167e9. Under compression the SPECTRAL
    # formula would give K=4.1666666667e10, so this pins the NONE fallback (R-002).
    type = 'CSVDiff'
    input = 'bulk_modulus_spectral.i'
    cli_args = 'Materials/elasticity/decomposition=NONE
                AuxKernels/d_aux/function=0.7
                AuxKernels/disp_x_aux/function=-1e-3*x
                AuxKernels/disp_y_aux/function=-2e-3*y
                Outputs/csv/file_base=bulk_modulus_none_compression'
    csvdiff = 'bulk_modulus_none_compression.csv'
    rel_err = 1e-8
    allow_warnings = true
    requirement = 'For decomposition = NONE the system shall report K_eff = g*K '
                  'independent of strain (not the spectral split value), emitting a '
                  'one-time warning that the exact contraction is spectral-only.'
  []
[]
